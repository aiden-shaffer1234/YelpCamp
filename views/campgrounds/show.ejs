<% layout('layouts/boilerplate') -%>
    <h1>
        <%= campground.title %>
    </h1>
    <h2>
        <%= campground.location %>
    </h2>
    <div>
        <img src="<%= campground.image %>" alt="camp image">
        <p>
            <%= campground.description %>
        </p>
    </div>
    <a href="/campgrounds">All Campgrounds</a><br>
    <form action="/campgrounds/<%= campground._id%>?_method=DELETE" method="post"><button>Delete</button></form>
    <a href="/campgrounds/<%=campground._id%>/edit">Edit Campground</a>